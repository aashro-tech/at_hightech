# Includes Page Configuration
@import 'EXT:at_hightech/Configuration/TypoScript/Page/page.typoscript'

plugin.tx_news {
  view {
    templateRootPaths {
      10 = EXT:at_hightech/Resources/Private/Extensions/News/Templates/
    }
    partialRootPaths {
      10 = EXT:at_hightech/Resources/Private/Extensions/News/Partials/
    }
    layoutRootPaths {
      10 = EXT:at_hightech/Resources/Private/Extensions/News/Layouts/
    }
  }
}

plugin.tx_indexedsearch {
  view {
    templateRootPaths.10 = EXT:at_hightech/Resources/Private/Extensions/IndexedSearch/Templates/
    partialRootPaths.10 = EXT:at_hightech/Resources/Private/Extensions/IndexedSearch/Partials/
    layoutRootPaths.10 = EXT:at_hightech/Resources/Private/Extensions/IndexedSearch/Layouts/
  }
}